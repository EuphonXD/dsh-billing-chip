{
  "name": "dsh-billing-chip",
  "version": "0.2.0",
  "description": "DSH 插件：右下角一块纯文字计费牌。特色是实时估算本轮花费 —— 订阅模型输出流按字符折 token，钱边写边涨，结算后给出「实际 · 预估」对比。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "SETUP-AI.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "billing",
    "token",
    "cost",
    "deepseek",
    "realtime",
    "streaming",
    "usage",
    "estimator"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "author": "Euphon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EuphonXD/dsh-billing-chip.git"
  },
  "homepage": "https://github.com/EuphonXD/dsh-billing-chip#readme",
  "bugs": {
    "url": "https://github.com/EuphonXD/dsh-billing-chip/issues"
  }
}
